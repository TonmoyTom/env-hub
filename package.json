{
  "name": "projectdockhub",
  "productName": "ProjectDockHub",
  "version": "0.0.1",
  "description": "A free, open source Docker-based local development environment with a GUI for Laravel and modern JavaScript and Python stacks.",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/compose.test.js tests/ports.test.js tests/laravel.test.js tests/Portcheck.test.js tests/Store.test.js tests/Stacks.test.js tests/Pipeline.test.js tests/Hub.test.js tests/Folders.test.js tests/Edit.test.js tests/Links.test.js tests/Dbname.test.js tests/Credentials.test.js tests/Volumes.test.js tests/Envfile.test.js tests/Missing.test.js tests/Lan.test.js tests/Versions.test.js tests/Portable.test.js tests/Installer.test.js tests/Stats.test.js",
    "dist": "electron-builder --win --publish never",
    "art": "electron scripts/make-brand-assets.js",
    "build:windows": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --win --mac --linux --publish never"
  },
  "author": "ProjectDockHub contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.projectdockhub.app",
    "productName": "ProjectDockHub",
    "files": [
      "main/**/*",
      "preload/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json",
      "PLANNING.md",
      "HANDOVER.md",
      "build/tray.png",
      "build/tray@2x.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ProjectDockHub",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerHeader": "build/installerHeader.bmp",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "ProjectDockHub contributors <noreply@projectdockhub.dev>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://projectdockhub.dev"
}
